# Copia este archivo a .env  (cp .env.example .env). NO subas .env a Git.
DB_USER=dw_user
DB_PASSWORD=dw_pass
DB_NAME=urban_dw
DB_HOST=localhost
DB_PORT=5433

# Area de estudio (claves INEGI): Ciudad de Mexico = entidad 09
# (16 alcaldias, claves de municipio 002 a 017). STUDY_MUN vacio = toda la CDMX.
STUDY_ENT=09
STUDY_MUN=

# CRS de trabajo para calcular areas/distancias (UTM zona 14N, cubre la CDMX)
WORK_CRS=EPSG:32614

# Tolerancia compartida para diferencias de borde cartografico (10 km)
BORDER_TOLERANCE_M=10000
